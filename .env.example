# Application Environment
# Options: local, dev, prod
APP_ENV=local

# Logging
LOG_LEVEL=INFO

# Database Configuration
# SQLite (default for local development)
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL example (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/review_intelligence

# Data Directory
DATA_DIR=./data

# Analysis Configuration
MAX_THEMES=6
SUMMARY_CACHE_TTL_MINUTES=120

# LLM Provider Configuration
# Options: mock, openai
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration (production)
# Comma-separated list of allowed origins
# Example: CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Security Configuration
# Maximum file upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760
# Maximum number of rows to process per file (DoS protection)
MAX_INGESTION_ROWS=50000
# Enable rate limiting for LLM API calls (requests per minute)
LLM_RATE_LIMIT_RPM=60
